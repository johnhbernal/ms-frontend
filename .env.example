# Local development — copy to `.env.local` (not committed)
REACT_APP_AUTH_API_URL=http://localhost:8081
REACT_APP_PRACTICA_API_URL=http://localhost:8082/api

# Docker build (`docker compose build`) — browser must reach these URLs from the host
# REACT_APP_AUTH_API_URL=http://localhost:8081
# REACT_APP_PRACTICA_API_URL=http://localhost:8082/api

# Production example (HTTPS)
# REACT_APP_AUTH_API_URL=https://auth.yourapp.com
# REACT_APP_PRACTICA_API_URL=https://practica.yourapp.com/api
