# Vite bakes VITE_* at build time — browser-reachable URLs (host localhost, not Docker service names).
VITE_AUTH_API_URL=http://localhost:8081
VITE_PRACTICA_API_URL=http://localhost:8082/api

# Deprecated CRA names (ignored by Vite; remove after one release):
# REACT_APP_AUTH_API_URL=http://localhost:8081
# REACT_APP_PRACTICA_API_URL=http://localhost:8082/api

# Docker / production examples:
# VITE_AUTH_API_URL=https://auth.yourapp.com
# VITE_PRACTICA_API_URL=https://practica.yourapp.com/api
